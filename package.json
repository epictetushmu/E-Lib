{
  "name": "e-lib",
  "private": true,
  "version": "1.0.0",
  "description": "E2E test tooling for E-Lib (Playwright + TypeScript)",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint qa playwright.config.ts",
    "lint:fix": "eslint qa playwright.config.ts --fix"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  }
}
