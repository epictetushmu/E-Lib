# E-Lib Environment Configuration

# Email Configuration (PHPMailer)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@epictetuslibrary.org
MAIL_FROM_NAME="Epictetus Library"
SUPPORT_EMAIL=support@epictetuslibrary.org

# Application
APP_ENV=development
APP_DEBUG=true
# Plain-HTTP local dev (php -S / vite): http://localhost:8000
# HTTPS via docker-compose's Caddy reverse proxy: https://localhost (self-signed) or
# https://your-domain.com in production once DOMAIN below is set to a real domain.
APP_URL=http://localhost:8000

# API Configuration
API_BASE_URL=http://127.0.0.1:8081/

# Domain Caddy issues a cert for (docker-compose only). "localhost" (default) gets a
# self-signed cert automatically; a real domain gets a real Let's Encrypt cert automatically
# — same mechanism for local and production, see docker/Caddyfile.
DOMAIN=localhost

# Local Docker only: layer the dev overrides (bind-mounted code, debug, throwaway MongoDB) onto
# the production compose file. Leave unset on the server.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# CAS Authentication
CAS_SERVER_URL=https://your-cas-server.com/cas
# PENDING: not yet confirmed whether HMU's CAS releases the university email directly as the
# validated principal, or a bare netid. If it's a bare netid, set this suffix (e.g. "@hmu.gr")
# so CasService::resolveLocalUser() can look up the matching local account. Leave empty otherwise.
CAS_EMAIL_DOMAIN=

# JWT Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here

# MongoDB Connection Options
# Use either ${MONGO_PASSWORD} or <db_password> in the URI; set MONGO_PASSWORD below (special chars are URL-encoded automatically).
# Keep the single quotes: docker compose also reads this file and would otherwise try to expand ${MONGO_PASSWORD} itself.
MONGO_URI='mongodb+srv://username:${MONGO_PASSWORD}@your-cluster.mongodb.net/?tls=true&appName=e-lib'
MONGO_PASSWORD=your_password_here
# Leave empty for Atlas (uses OS certificate store). Only set if you need a custom CA file path:
# MONGO_TLS_CA_FILE=
# Optional: set to 1 only if you explicitly want MongoDB Stable API in the driver handshake
# MONGO_SERVER_API=1

# Ngrok Configuration (for development tunneling)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# Content search ("search inside books") — see docker-compose.yml's embedder/worker services.
# Inside Docker the app/worker reach the embedder by service name; for `php -S` + a host-side
# worker use the dev port: http://127.0.0.1:8082
EMBEDDING_URL=http://embedder:11434
# The Ollama model to embed with — must match the tag the embedder service pulls (docker-compose.yml).
# Also stored on every page vector: changing it makes the worker re-embed every book in the background
# (old chunks keep serving keyword search meanwhile).
EMBEDDING_MODEL=bge-m3:567m
# Output size of the model above; used by scripts/db-setup.php for the vector index.
EMBEDDING_DIMENSIONS=1024
# Seconds a search waits for the query embedding before falling back to keyword-only results.
EMBEDDING_TIMEOUT=2
WORKER_BATCH_SIZE=16
WORKER_POLL_SECONDS=5
# A book is shown only if its best page scores at least SEMANTIC_MIN_SCORE (Atlas cosine score, 0..1)
# and within SEMANTIC_MARGIN of the best page overall.
SEMANTIC_MIN_SCORE=0.75
SEMANTIC_MARGIN=0.03
